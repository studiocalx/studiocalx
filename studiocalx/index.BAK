  <!-- JS スクリプト -->
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      // 0. スクロールに応じた背景明度の動的変化
      window.addEventListener("scroll", function() {
        const scrollTop = window.scrollY;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const scrollFraction = Math.min(1, Math.max(0, scrollTop / maxScroll));

        const r = Math.round(10 + (28 - 10) * scrollFraction);
        const g = Math.round(11 + (32 - 11) * scrollFraction);
        const b = Math.round(13 + (41 - 13) * scrollFraction);

        document.body.style.backgroundColor = `rgb(${r}, ${g}, ${b})`;
      });

      // 1. ヒーロー背景スライドショー
      const heroBgImgs = document.querySelectorAll('.hero-bg-img');
      if (heroBgImgs.length > 1) {
        let currentBg = 0;
        setInterval(() => {
          heroBgImgs[currentBg].classList.remove('active');
          currentBg = (currentBg + 1) % heroBgImgs.length;
          heroBgImgs[currentBg].classList.add('active');
        }, 5000);
      }

      // 2. デモ表示切り替えトグル
      const toggleBtn = document.getElementById("toggle-demos-btn");
      const extraDemos = document.querySelectorAll(".extra-demo");
      let isExpanded = false;

      if (toggleBtn) {
        toggleBtn.addEventListener("click", function() {
          isExpanded = !isExpanded;
          extraDemos.forEach(el => {
            el.style.display = isExpanded ? "flex" : "none";
          });
          toggleBtn.textContent = isExpanded 
            ? "代表的な3案のみ表示" 
            : "すべてのモデルサイトを見る（全9案） →";
        });
      }

      // 3. お問い合わせタブ切替
      const visitBtn = document.getElementById("tab-visit-btn");
      const onlineBtn = document.getElementById("tab-online-btn");
      const visitForm = document.getElementById("form-visit");
      const onlineForm = document.getElementById("form-online");

      if (visitBtn && onlineBtn) {
        visitBtn.addEventListener("click", function() {
          visitBtn.classList.add("active");
          onlineBtn.classList.remove("active");
          visitForm.style.display = "grid";
          onlineForm.style.display = "none";
        });

        onlineBtn.addEventListener("click", function() {
          onlineBtn.classList.add("active");
          visitBtn.classList.remove("active");
          onlineForm.style.display = "grid";
          visitForm.style.display = "none";
        });
      }

     // 4. Note への誘導リンクカード（自動取得エラー回避版）
const grid = document.getElementById("note-posts-grid");
if (grid) {
    grid.style.gridColumn = "1 / -1";
    grid.innerHTML = `
        <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 30px; text-align: center; margin: 20px 0;">
            <p style="color: #fff; font-size: 1.1rem; margin-bottom: 15px; font-weight: 500;">Studio Calx 編集部の最新記事はNoteで公開中</p>
            <p style="color: #aaa; font-size: 0.9rem; margin-bottom: 25px;">「音の答え」「実践AI活用講座」「20世紀音楽史」などのシリーズを連載しています。</p>
            <a href="https://note.com/studiocalx" target="_blank" rel="noopener noreferrer" style="display: inline-block; background: #232323; color: #fff; padding: 12px 28px; border-radius: 30px; text-decoration: none; border: 1px solid rgba(255,255,255,0.2); transition: all 0.3s ease;">
                Noteで記事を読む ↗
            </a>
        </div>
    `;
}

          data.items.slice(0, 3).forEach(item => {
            const pubDate = new Date(item.pubDate);
            const dateStr = `${pubDate.getFullYear()}.${String(pubDate.getMonth() + 1).padStart(2, '0')}.${String(pubDate.getDate()).padStart(2, '0')}`;

            const card = document.createElement("a");
            card.href = item.link;
            card.target = "_blank";
            card.rel = "noopener noreferrer";
            card.className = "note-card";

            card.innerHTML = `
              <span class="note-card-date">${dateStr}</span>
              <h3 style="font-size: 1rem; line-height: 1.5; margin: 0; font-weight: 700;">${item.title}</h3>
            `;

            grid.appendChild(card);
          });
        })
        .catch(() => {
          const grid = document.getElementById("note-posts-grid");
          if (grid) grid.innerHTML = '<p style="text-align: left; color: #c5a059; grid-column: 1 / -1;">記事の読み込みに失敗しました。</p>';
        });
    });
  </script>
</body>
</html>